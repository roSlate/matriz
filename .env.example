# Example configuration with fictional values. Copy to .env and adapt; .env is ignored by Git.
# Never commit real credentials.

# Database container (compose.yaml)
POSTGRES_DB=matriz
POSTGRES_USER=matriz
POSTGRES_PASSWORD=change-me-locally

# Backend connection to the database
DB_URL=jdbc:postgresql://localhost:5432/matriz
DB_USER=matriz
DB_PASSWORD=change-me-locally
